<?xml version="1.0" encoding="utf-8"?>
<!-- Sin filtro de paquetes (android:packageNames): antes solo escuchaba Instagram/TikTok (para
     Reels), pero el aviso de "llevas X min en redes sociales" (ver
     ReelsBlockAccessibilityService.checkAlertRules) necesita saber cuándo se abre CUALQUIER app
     configurada en una regla de aviso, no solo esas dos. El recorrido de nodos de Reels/TikTok (el
     trabajo pesado) se sigue limitando a esos paquetes en el propio código, así que esto no añade
     trabajo extra por evento. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows|flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="200"
    android:description="@string/accessibility_service_description" />
