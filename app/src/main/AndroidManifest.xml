<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Alarmas y recordatorios -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />

    <!-- Bloqueo de contenido (overlay + accesibilidad) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Analítica de uso de pantalla (permiso especial, se concede desde Ajustes) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Ignorar optimización de batería (se solicita explícitamente al usuario) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Actualizaciones: descargar el APK del último release de GitHub e instalarlo -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- La app ya tiene su propia UI de progreso de descarga (UpdateScreen); sin este permiso,
         DownloadManager.Request.VISIBILITY_HIDDEN se ignora y muestra igual la notificación nativa. -->
    <uses-permission android:name="android.permission.DOWNLOAD_WITHOUT_NOTIFICATION" />

    <!-- Necesario para poder resolver nombre/ícono de apps instaladas en el dashboard de uso -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".WakeUpApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.WakeUp"
        android:supportsRtl="true"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.WakeUp.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".alarm.AlarmRingingActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.WakeUp.Alarm"
            android:screenOrientation="portrait" />

        <service
            android:name=".alarm.RingingForegroundService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <activity
            android:name=".alarm.TimerRingingActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.WakeUp.Alarm"
            android:screenOrientation="portrait" />

        <service
            android:name=".alarm.TimerForegroundService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <receiver android:name=".alarm.AlarmReceiver" android:exported="false">
            <intent-filter>
                <action android:name="com.fritangui.wakeup.action.ALARM_FIRE" />
            </intent-filter>
        </receiver>

        <receiver android:name=".alarm.PreAlarmReceiver" android:exported="false">
            <intent-filter>
                <action android:name="com.fritangui.wakeup.action.PRE_ALARM_FIRE" />
                <action android:name="com.fritangui.wakeup.action.SKIP_NEXT_OCCURRENCE" />
            </intent-filter>
        </receiver>

        <receiver android:name=".alarm.TaskReminderReceiver" android:exported="false">
            <intent-filter>
                <action android:name="com.fritangui.wakeup.action.TASK_REMINDER_FIRE" />
            </intent-filter>
        </receiver>

        <receiver android:name=".alarm.BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <!-- MIUI a veces no envía BOOT_COMPLETED estándar tras una actualización de la app -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widget.NextClassesWidgetReceiver"
            android:exported="false"
            android:label="Próximas clases">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/next_classes_widget_info" />
        </receiver>

        <service
            android:name=".blocking.ReelsBlockAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:label="Bloqueo de contenido (Wake up)">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name=".blocking.BlockOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="app_usage_limit_overlay" />
        </service>

        <receiver
            android:name=".widget.NextTasksWidgetReceiver"
            android:exported="false"
            android:label="Próximas tareas">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/next_tasks_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.ScreenTimeWidgetReceiver"
            android:exported="false"
            android:label="Tiempo de pantalla">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/screen_time_widget_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- WakeUpApp ya implementa Configuration.Provider con el WorkerFactory de Hilt (para que
             los Workers reciban dependencias inyectadas), así que hay que quitar el inicializador
             automático por defecto de WorkManager o queda inicializado dos veces. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
